<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc nc-whitelist-panel-title}"
    MinSize="760 560">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Orientation="Horizontal">
            <LineEdit Name="SearchInput"
                      HorizontalExpand="True"
                      PlaceHolder="{Loc nc-whitelist-panel-search-placeholder}" />
            <Button Name="SearchButton"
                    Text="{Loc nc-whitelist-panel-search}"
                    Margin="6 0 0 0" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <LineEdit Name="AddInput"
                      HorizontalExpand="True"
                      PlaceHolder="{Loc nc-whitelist-panel-add-placeholder}" />
            <Button Name="AddButton"
                    Text="{Loc nc-whitelist-panel-add}"
                    Margin="6 0 0 0" />
        </BoxContainer>

        <Label Name="StatusLabel" Margin="0 8 0 4" />

        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="Entries" Orientation="Vertical" />
            </ScrollContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <Label Name="TotalLabel" HorizontalExpand="True" />
            <Button Name="PreviousButton" Text="{Loc nc-whitelist-panel-previous}" />
            <Label Name="PageLabel" Margin="8 4" />
            <Button Name="NextButton" Text="{Loc nc-whitelist-panel-next}" />
            <Button Name="RefreshButton"
                    Text="{Loc nc-whitelist-panel-refresh}"
                    Margin="8 0 0 0" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
