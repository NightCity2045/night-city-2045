<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client._NC.Netrunning.UI"
               Title="Консоль локальной сети"
               MinWidth="920"
               MinHeight="620">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <PanelContainer StyleClasses="NetTerminalHeader">
            <BoxContainer Orientation="Horizontal" Margin="10" SeparationOverride="10">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                    <Label Name="ServerNameLabel"
                           Text="СЕРВЕР://НЕИЗВЕСТЕН"
                           StyleClasses="NetTerminalTitle"
                           ClipText="True" />
                    <Label Text="АДМИНИСТРАТИВНАЯ КОНСОЛЬ ЛОКАЛЬНОЙ СЕТИ"
                           StyleClasses="NetTerminalSubtitle"
                           ClipText="True" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="0 4 0 0">
                        <PanelContainer StyleClasses="NetTerminalBadge">
                            <Label Name="ProviderLabel"
                                   Text="ЛКП: нет"
                                   StyleClasses="NetTerminalBadgeText" />
                        </PanelContainer>
                        <PanelContainer StyleClasses="NetTerminalBadge">
                            <Label Name="LoadLabel"
                                   Text="Нагрузка: 0/0"
                                   StyleClasses="NetTerminalBadgeText" />
                        </PanelContainer>
                        <PanelContainer StyleClasses="NetTerminalBadge">
                            <Label Name="ModuleLabel"
                                   Text="Модули: 0/0"
                                   StyleClasses="NetTerminalBadgeText" />
                        </PanelContainer>
                        <PanelContainer StyleClasses="NetTerminalBadge">
                            <Label Name="DeviceCountLabel"
                                   Text="Узлы: 0"
                                   StyleClasses="NetTerminalBadgeText" />
                        </PanelContainer>
                        <PanelContainer Name="DaemonBadge" StyleClasses="NetTerminalBadge">
                            <Label Name="DaemonLabel"
                                   Text="Демон: пусто"
                                   StyleClasses="NetTerminalBadgeText" />
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>

                <PanelContainer StyleClasses="NetTerminalPanel"
                                MinWidth="230"
                                MinHeight="92">
                    <ui:NetServerTelemetryControl Name="TelemetryPanel"
                                                  HorizontalExpand="True"
                                                  VerticalExpand="True" />
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
            <PanelContainer StyleClasses="NetTerminalPanel" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="УСТРОЙСТВА СЕГМЕНТА ЛКП" StyleClasses="NetTerminalSectionTitle" />
                        <BoxContainer HorizontalExpand="True" />
                        <Button Name="RefreshButton" Text="Обновить топологию" StyleClasses="NetTerminalButton" />
                    </BoxContainer>
                    <Label Text="В локальную сеть выводятся только узлы, сидящие на том же прямом источнике логического питания."
                           StyleClasses="NetTerminalSectionText"
                           ClipText="True" />
                    <PanelContainer StyleClasses="NetTerminalInset" VerticalExpand="True">
                        <ItemList Name="DeviceList" VerticalExpand="True" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="NetTerminalPanel" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                    <Label Text="ПОРТЫ ТОПОЛОГИИ" StyleClasses="NetTerminalSectionTitle" />
                    <Label Text="Свободные порты принимают новые комнаты и профильные кластеры локальной сети."
                           StyleClasses="NetTerminalSectionText"
                           ClipText="True" />
                    <PanelContainer StyleClasses="NetTerminalInset" VerticalExpand="True">
                        <ItemList Name="PortList" VerticalExpand="True" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="NetTerminalPanel" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                    <Label Text="СБОРКА МОДУЛЯ" StyleClasses="NetTerminalSectionTitle" />
                    <Label Text="Выбери пакет комнаты и вшей его в совместимый расширительный порт."
                           StyleClasses="NetTerminalSectionText"
                           ClipText="True" />
                    <PanelContainer StyleClasses="NetTerminalInset" MinHeight="150">
                        <ItemList Name="ModuleList" VerticalExpand="True" />
                    </PanelContainer>
                    <PanelContainer StyleClasses="NetTerminalInset" VerticalExpand="True">
                        <RichTextLabel Name="ModuleDesc" Margin="4" VerticalExpand="True" />
                    </PanelContainer>
                    <Button Name="ConstructButton" Text="Собрать модуль" StyleClasses="NetTerminalActionButton" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="NetTerminalFooter">
            <BoxContainer Orientation="Horizontal" Margin="8" SeparationOverride="8">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                    <Label Name="AccessLabel"
                           Text="ДОСТУП: НЕТ СЕАНСА"
                           StyleClasses="NetTerminalSectionTitle"
                           ClipText="True" />
                    <Label Name="FooterLabel"
                           Text="Для админ-сеанса нужна дека, уже связанная с этим сервером."
                           StyleClasses="NetTerminalFooterText"
                           ClipText="True" />
                </BoxContainer>
                <Button Name="AdminButton"
                        Text="Получить права администратора"
                        MinWidth="250"
                        StyleClasses="NetTerminalActionButton" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
